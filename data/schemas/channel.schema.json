{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cn-ai-startups:channel",
  "title": "Sourced public organization channel",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ch-[a-z0-9-]+$"
    },
    "layer": {
      "enum": [
        "official",
        "recruitment_platform",
        "professional_social"
      ]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "purpose": {
      "enum": [
        "recruitment",
        "business",
        "bp",
        "general",
        "technical",
        "public_profile"
      ]
    },
    "owner": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "organization"
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "verification_status": {
      "enum": [
        "confirmed",
        "partial",
        "historical"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s[0-9]{2,}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "layer",
    "platform",
    "url",
    "purpose",
    "owner",
    "verification_status",
    "checked_at",
    "source_ids",
    "notes"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VC discovery list referencing canonical company records",
  "type": "object",
  "required": [
    "schema_version",
    "scope_note",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "company_id",
          "source_ids",
          "discovery_use"
        ],
        "additionalProperties": false,
        "properties": {
          "company_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[0-9]+$"
            }
          },
          "discovery_use": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cn-ai-startups:person-batch",
  "title": "Verified public people observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_only",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "public_only": {
      "const": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_type",
          "entity_id",
          "person_name",
          "platform",
          "url",
          "checked_at",
          "evidence_title",
          "verification_status",
          "identity_evidence"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "operating_organization",
              "investment_firm"
            ]
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "person_name": {
            "type": "string",
            "minLength": 1
          },
          "person_role": {
            "type": [
              "string",
              "null"
            ]
          },
          "background": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_firms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "platform": {
            "enum": [
              "linkedin",
              "x",
              "github",
              "scholar",
              "jike",
              "zhihu",
              "personal_site",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "evidence_title": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "const": "confirmed"
          },
          "identity_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url",
                "supports",
                "published_date",
                "checked_at"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "supports": {
                  "type": "string",
                  "minLength": 1
                },
                "published_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                },
                "checked_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "account_type": {
            "const": "User"
          }
        }
      }
    }
  }
}

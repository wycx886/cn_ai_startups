{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed public Layer 2 candidate batch",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "public_only": {
      "const": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "entity_type": {
            "enum": [
              "operating_organization",
              "investment_firm"
            ]
          },
          "entity_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "platform": {
            "enum": [
              "boss_zhipin",
              "liepin",
              "maimai"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "observed_name": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "evidence_title": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "const": "confirmed"
          }
        },
        "required": [
          "entity_type",
          "entity_id",
          "platform",
          "url",
          "observed_name",
          "checked_at",
          "evidence_title",
          "verification_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "public_only",
    "entries"
  ],
  "additionalProperties": false
}

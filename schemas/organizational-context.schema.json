{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cn-ai-startups:organizational-context",
  "title": "Organization form and sourced platform relationship",
  "type": "object",
  "properties": {
    "form": {"enum": ["independent_organization", "corporate_spinout", "corporate_subsidiary", "internal_team", "research_lab", "product_project", "unresolved"]},
    "parent_platform_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "uniqueItems": true},
    "relationship_status": {"enum": ["confirmed", "reported", "unresolved"]},
    "summary": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]{2,}$"}, "minItems": 1, "uniqueItems": true},
    "checked_at": {"type": "string", "format": "date"}
  },
  "required": ["form", "parent_platform_ids", "relationship_status", "summary", "source_ids", "checked_at"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worknet investor institution",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "group": {
      "enum": [
        "emerging",
        "established"
      ]
    },
    "founded": {
      "type": "object",
      "properties": {
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "year",
        "basis"
      ],
      "additionalProperties": false
    },
    "team": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_firms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "background": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "role",
          "previous_firms",
          "background"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "focus": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "representative_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "enum": [
              "prior_firm",
              "current_firm"
            ]
          },
          "investor_or_team": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "company",
          "attribution",
          "investor_or_team",
          "outcome",
          "evidence_source_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "recent_activity": {
      "type": "string",
      "minLength": 1
    },
    "why_follow": {
      "type": "string",
      "minLength": 1
    },
    "difference": {
      "type": "string",
      "minLength": 1
    },
    "contacts": {
      "type": "object",
      "properties": {
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "careers_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "recruitment_email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_email_purpose": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "website",
        "careers_url",
        "recruitment_email",
        "other_email",
        "other_email_purpose"
      ],
      "additionalProperties": false
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "published_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "supports",
          "published_date",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "main",
            "watchlist",
            "adjacent"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "aliases",
    "group",
    "founded",
    "team",
    "focus",
    "stage",
    "representative_cases",
    "recent_activity",
    "why_follow",
    "difference",
    "contacts",
    "notes",
    "sources",
    "checked_at",
    "coverage"
  ],
  "additionalProperties": false
}

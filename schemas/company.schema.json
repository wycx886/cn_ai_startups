{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cn_ai_startups company",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "category_id": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "products": {
      "type": "string",
      "minLength": 1
    },
    "locations_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "editorial_analysis"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "peer_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "summary",
        "peer_names"
      ],
      "additionalProperties": false
    },
    "investment": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "confirmed_disclosure",
            "partial",
            "not_found"
          ]
        }
      },
      "required": [
        "summary",
        "verification_status"
      ],
      "additionalProperties": false
    },
    "contacts": {
      "type": "object",
      "properties": {
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "careers_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "recruitment_email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_email_purpose": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "website",
        "careers_url",
        "recruitment_email",
        "other_email",
        "other_email_purpose"
      ],
      "additionalProperties": false
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "published_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "supports",
          "published_date",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "original_name": {
          "type": "string",
          "minLength": 1
        },
        "original_track": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "original_subtrack": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "original_name",
        "original_track",
        "original_subtrack"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "aliases",
    "category_id",
    "focus",
    "products",
    "locations_text",
    "comparison",
    "investment",
    "contacts",
    "notes",
    "checked_at",
    "sources",
    "provenance"
  ],
  "additionalProperties": false
}
